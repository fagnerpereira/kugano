<section class="card rounded-2xl p-3.5 sm:p-4 shadow-sm flex flex-col gap-3">
  <!-- Teclado Guia da Voz (opcional) -->
  <div id="voice-keyboard-panel" class="hidden hide-in-focus subtle rounded-xl p-2.5 border-l-4 border-l-amber-500 flex flex-col gap-1.5">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <span class="text-xs font-bold text-amber-800 dark:text-amber-200">
        🎤 Guia da Voz (Opcional)
      </span>
      <div class="flex items-center gap-2.5 flex-wrap">
        <select id="voice-timbre-select" aria-label="Timbre da Voz" class="px-2 py-0.5 rounded-lg text-[11px] font-semibold card text-[var(--text-main)] cursor-pointer">
          <option value="rhodes" selected>Rhodes</option>
          <option value="piano">Piano Agudo</option>
          <option value="oohs">Voz Suave</option>
        </select>
        <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--text-main)] cursor-pointer">
          <input type="checkbox" id="chk-voice-audio" checked class="w-3.5 h-3.5 rounded accent-amber-500 cursor-pointer">
          Ouvir
        </label>
      </div>
    </div>
    <div class="piano-wrap">
      <div class="voice-bed" id="voice-bed"></div>
    </div>
  </div>

  <!-- Teclado Fixo Principal (C2 a C6) -->
  <div class="piano-wrap">
    <div class="piano-bed" id="piano-bed"></div>
  </div>

  <!-- Dock de Prática -->
  <div class="subtle rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-1 bg-slate-200/80 dark:bg-slate-900 p-1 rounded-xl border border-[var(--border)] self-start sm:self-auto">
      <button type="button" data-hand="both" class="hand-btn px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition">2 Mãos</button>
      <button type="button" data-hand="lh" class="hand-btn px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition">Só Esquerda</button>
      <button type="button" data-hand="rh" class="hand-btn px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer transition">Só Direita</button>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <label for="bpm-slider" class="text-xs font-bold text-[var(--text-muted)]">
        <span id="bpm-text" class="font-mono-code font-extrabold text-[var(--text-main)]">76 BPM</span>
      </label>
      <input type="range" id="bpm-slider" min="48" max="140" value="76" class="w-24 sm:w-28 accent-blue-600 cursor-pointer">
      <div id="bpm-presets" class="flex items-center gap-1"></div>
    </div>
  </div>
</section>
